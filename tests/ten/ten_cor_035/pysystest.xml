<?xml version="1.0" encoding="utf-8"?>
<pysystest type="auto">

    <description>
        <title>Gateway: get network config and check privacy headers</title>
        <purpose><![CDATA[
Makes a call to the network-config URL (this is not the rpc call) and just checks that the privacy headers as expected
are contained.
]]>
        </purpose>
    </description>

    <classification>
        <groups inherit="true">
            <group>gateway</group>
        </groups>
        <modes inherit="true">
            <mode>ten.sepolia</mode>
            <mode>ten.uat</mode>
            <mode>ten.dev</mode>
            <mode>ten.local</mode>
            <mode>ten.sim</mode>
        </modes>
    </classification>

    <data>
        <class name="PySysTest" module="run"/>
    </data>

    <traceability>
        <requirements>
            <requirement id=""/>
        </requirements>
    </traceability>
</pysystest>
