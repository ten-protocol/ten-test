<?xml version="1.0" encoding="utf-8"?>
<pysystest type="auto">

    <description>
        <title>Visibility Config: visibility with a large gas cost should burn all the supplied gas</title>
        <purpose><![CDATA[
If the visibilityRules function contains an expensive loop it should burn all the gas on deployment but the
contract should be deployed and default to auto (so private).
]]>
        </purpose>
    </description>

    <classification>
        <groups inherit="true">
            <group>vis_config</group>
        </groups>
        <modes inherit="true">
            <mode>ten.sepolia</mode>
            <mode>ten.uat</mode>
            <mode>ten.dev</mode>
            <mode>ten.local</mode>
            <mode>ten.sim</mode>
        </modes>
    </classification>

    <data>
        <class name="PySysTest" module="run"/>
    </data>

    <traceability>
        <requirements>
            <requirement id=""/>
        </requirements>
    </traceability>
</pysystest>
